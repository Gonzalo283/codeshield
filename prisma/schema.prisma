// CodeShield.sh — Production Schema
// Dev: SQLite (file:./dev.db)
// Prod: switch DATABASE_URL to Postgres + `provider = "postgresql"`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Unpooled URL for migrations (Neon's pooled URL uses PgBouncer which blocks some migration ops)
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ── NextAuth models ──
model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Core User ──
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  githubId      String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  apiKeys       ApiKey[]
  subscriptions Subscription[]
  usageLogs     UsageLog[]
  scans         ScanRecord[]
  webhooks      WebhookSubscription[]

  // Stripe
  stripeCustomerId String? @unique
}

// ── API Keys (DB-backed, replaces in-memory Map) ──
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String    @default("Default key")
  prefix     String    // "cs_live_" or "cs_test_" (for display)
  last4      String    // last 4 chars for display (e.g. "ab12")
  keyHash    String    @unique // SHA-256 of the full key
  plan       String    @default("free") // free | starter | growth | enterprise
  scansUsed  Int       @default(0)
  resetAt    DateTime  // monthly reset boundary
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

// ── Subscriptions (Stripe-backed) ──
model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  stripeCustomerId     String
  stripeSubscriptionId String    @unique
  stripePriceId        String
  planId               String    // free | team | business | enterprise
  status               String    // active | past_due | canceled | incomplete | trialing
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([status])
}

// ── Usage Tracking (per scan, auditable) ──
model UsageLog {
  id         String   @id @default(cuid())
  userId     String?
  apiKeyId   String?
  endpoint   String   // "/api/v1/scan" | "/api/scan" | "webhook.github"
  repoFullName String? // "owner/repo" if applicable
  filesScanned Int    @default(0)
  vulnFound   Int     @default(0)
  durationMs  Int     @default(0)
  status      String  @default("ok") // ok | error | quota_exceeded | rate_limited
  errorCode   String?
  ip          String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([createdAt])
}

// ── Scan Records (persisted results) ──
model ScanRecord {
  id             String   @id @default(cuid())
  userId         String?
  repoFullName   String?
  source         String   // "dashboard" | "webhook" | "api" | "cli"
  status         String   @default("completed") // pending | completed | failed
  filesScanned   Int      @default(0)
  critical       Int      @default(0)
  high           Int      @default(0)
  medium         Int      @default(0)
  low            Int      @default(0)
  findingsJson   String?  // JSON-encoded findings
  commitSha      String?
  branch         String?
  durationMs     Int      @default(0)
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([repoFullName, createdAt])
}

// ── GitHub Webhook Subscriptions (repos registered for auto-scan) ──
model WebhookSubscription {
  id           String   @id @default(cuid())
  userId       String
  repoFullName String   // "owner/repo"
  webhookId    String   // GitHub's webhook ID
  secret       String   // HMAC secret (encrypt in production)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, repoFullName])
  @@index([repoFullName])
}

// ── Rate limit buckets (persistent, multi-instance safe) ──
model RateLimitBucket {
  key        String   @id // e.g. "ip:1.2.3.4" or "apikey:<hash>:minute"
  tokens     Int
  windowEnd  DateTime
  updatedAt  DateTime @updatedAt
}
